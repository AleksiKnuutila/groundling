<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ page_title or "Grounded Answer" }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&family=Newsreader:opsz,wght@6..72,400;6..72,500&display=swap" rel="stylesheet">
<style>
  :root {
    --ink: #1a1c1e; --ink-soft: #565b61; --line: #e6e6e2; --paper: #fbfbf9;
    --sup: #2f8a52; --par: #a9760a; --uns: #c43d2c; --cit: #3160a8;
    --accent: #2a2c2e;
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--paper); color: var(--ink);
    font-family: "IBM Plex Sans", system-ui, sans-serif; font-size: 17px; line-height: 1.62; }
  .wrap { max-width: 760px; margin: 0 auto; padding: 0 28px 140px; }

  /* ---- Header strip ---- */
  .trustbar { position: sticky; top: 0; z-index: 30; background: rgba(251,251,249,.92);
    backdrop-filter: blur(8px); border-bottom: 1px solid var(--line);
    margin: 0 -28px 36px; padding: 14px 28px; display: flex; align-items: center; gap: 18px; }
  .brand { font-family: "Newsreader", serif; font-size: 19px; letter-spacing: .2px; }
  .brand b { font-weight: 500; }
  .brand .dot { color: var(--sup); }
  .tally { flex: 1; display: flex; gap: 13px; font-family: "IBM Plex Mono", monospace;
    font-size: 12px; color: var(--ink-soft); white-space: nowrap; }
  .tally b { color: var(--ink); }
  .tally i { font-style: normal; width: 8px; height: 8px; border-radius: 50%;
    display: inline-block; margin-right: 5px; vertical-align: middle; }
  .toggle { font: inherit; font-size: 13px; border: 1px solid var(--line); background: #fff;
    color: var(--ink); padding: 7px 12px; border-radius: 8px; cursor: pointer; white-space: nowrap; }
  .toggle[aria-pressed="true"] { background: var(--accent); color: #fff; border-color: var(--accent); }

  /* ---- Title + subtitle ---- */
  h1 { font-family: "Newsreader", serif; font-weight: 500; font-size: 33px; line-height: 1.2;
    letter-spacing: -.2px; margin: 6px 0 4px; }
  .sub { color: var(--ink-soft); font-size: 14px; margin-bottom: 30px;
    font-family: "IBM Plex Mono", monospace; }

  /* ---- Answer body ---- */
  main h2 { font-family: "Newsreader", serif; font-weight: 500; font-size: 24px; margin: 38px 0 6px; }
  main h3 { font-size: 14px; text-transform: uppercase; letter-spacing: .09em; color: var(--ink-soft);
    margin: 30px 0 2px; font-weight: 600; }
  main p { margin: 14px 0; }
  main ul, main ol { padding-left: 1.4em; }

  /* ---- Inline cite styling ---- */
  a.cite { color: inherit; text-decoration: none; cursor: pointer; padding-bottom: 1px;
    border-bottom: 2px solid #cfcfca; }
  a.cite[data-state="supported"]    { border-color: #bfe0cb; }
  a.cite[data-state="partial"]      { border-color: var(--par); }
  a.cite[data-state="unsupported"]  { border-color: var(--uns); }
  a.cite[data-state="needs-citation"]{ border-color: var(--cit); border-bottom-style: dashed; }
  a.cite[data-state="partial"]::before,
  a.cite[data-state="unsupported"]::before,
  a.cite[data-state="needs-citation"]::before {
    content: ""; display: inline-block; width: 7px; height: 7px; border-radius: 50%;
    margin-right: 3px; vertical-align: 1px; }
  a.cite[data-state="partial"]::before { background: var(--par); }
  a.cite[data-state="unsupported"]::before { background: var(--uns); }
  a.cite[data-state="needs-citation"]::before { background: var(--cit); }
  a.cite:hover { background: #fffceb; }
  a.cite:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  /* Spotlight mode: dim supported cites so weaker ones pop. */
  body.weak a.cite[data-state="supported"],
  body.weak a.cite:not([data-state]),
  body.weak a.cite[data-state="none"] { border-color: var(--line); color: var(--ink-soft); }
  body.weak a.cite[data-state="supported"]:hover { color: var(--ink); }

  /* ---- Hover card ---- */
  #card { position: fixed; z-index: 50; width: 420px; background: #fff; border: 1px solid var(--line);
    border-radius: 12px; box-shadow: 0 16px 44px -14px rgba(20,20,20,.34); overflow: hidden;
    opacity: 0; transform: translateY(4px); pointer-events: none; transition: opacity .12s, transform .12s; }
  #card.show { opacity: 1; transform: translateY(0); }
  .card-band { display: flex; align-items: center; gap: 9px; padding: 10px 14px; font-size: 13px;
    font-weight: 600; color: #fff; }
  .card-band .vg { width: 18px; height: 18px; border-radius: 50%; background: rgba(255,255,255,.25);
    display: grid; place-items: center; font-size: 12px; }
  .band-supported { background: var(--sup); }
  .band-partial   { background: var(--par); }
  .band-unsupported { background: var(--uns); }
  .band-needs-citation { background: var(--cit); }
  .band-none { background: var(--ink-soft); }
  .card-body { padding: 13px 14px 14px; }
  .card-src { font-family: "IBM Plex Mono", monospace; font-size: 11px; color: var(--ink-soft);
    display: flex; align-items: center; gap: 6px; margin-bottom: 10px; }
  .card-src .kind { background: #f0f0ec; padding: 2px 6px; border-radius: 5px; }
  .crop { position: relative; border: 1px solid var(--line); border-radius: 8px;
    width: 392px; height: 132px; overflow: hidden; background: #fff; }
  .crop img { position: absolute; max-width: none; }
  .crop-hl { position: absolute; background: rgba(255,221,64,.28);
    outline: 1.5px solid rgba(196,150,0,.7); border-radius: 2px; pointer-events: none; }
  .excerpt { font-size: 13.5px; line-height: 1.5; color: #33373b; max-height: 132px; overflow: hidden;
    -webkit-mask-image: linear-gradient(#000 75%, transparent); mask-image: linear-gradient(#000 75%, transparent); }
  .excerpt mark { background: #fff1a8; padding: 0 2px; border-radius: 2px; }
  .card-foot { margin-top: 11px; font-size: 11.5px; color: var(--ink-soft); display: flex;
    justify-content: space-between; align-items: center; }
  .card-foot .cta { color: var(--accent); font-weight: 600; }

  /* ---- Modal ---- */
  dialog.detail { border: none; border-radius: 14px; padding: 0; max-width: 760px; width: 92vw;
    box-shadow: 0 30px 80px -20px rgba(0,0,0,.5); }
  dialog.detail::backdrop { background: rgba(20,22,24,.42); backdrop-filter: blur(2px); }
  .d-band { padding: 16px 20px; color: #fff; display: flex; align-items: center; gap: 11px; }
  .d-band h4 { margin: 0; font-size: 16px; font-weight: 600; }
  .d-body { padding: 20px; display: grid; gap: 16px; }
  .d-claim { font-family: "Newsreader", serif; font-size: 20px; line-height: 1.35; }
  .d-note { background: #f7f7f4; border-radius: 10px; padding: 13px 15px; font-size: 14px;
    line-height: 1.55; color: #393d41; }
  .d-note b { font-family: "IBM Plex Mono", monospace; font-size: 11px; text-transform: uppercase;
    letter-spacing: .06em; color: var(--ink-soft); display: block; margin-bottom: 4px; font-weight: 600; }
  .d-page { border: 1px solid var(--line); border-radius: 8px; overflow: hidden; position: relative; }
  .d-page img { display: block; width: 100%; }
  .d-page-hl { position: absolute; background: rgba(255,221,64,.3);
    outline: 2px solid rgba(196,150,0,.75); pointer-events: none; }
  .d-src { font-size: 12.5px; color: var(--ink-soft); word-break: break-all; }
  .d-src a { color: var(--cit); }
  .close { position: absolute; top: 14px; right: 16px; width: 30px; height: 30px; border-radius: 50%;
    border: none; background: rgba(255,255,255,.22); color: #fff; font-size: 17px; cursor: pointer; }

  @media (hover: none) { #card { display: none !important; } }
</style>
</head>
<body>
<div class="wrap">
  <div class="trustbar">
    <div class="brand"><b>Groundling</b><span class="dot">.</span></div>
    <div class="tally" id="tally">
      <span><b>{{ total_cites }}</b> cites validated</span>
    </div>
    {% if has_judge_data %}
    <button class="toggle" id="weakBtn" aria-pressed="false">Spotlight weak claims</button>
    {% endif %}
  </div>
  {% if page_title %}<h1>{{ page_title }}</h1>{% endif %}
  {% if subtitle %}<div class="sub">{{ subtitle }}</div>{% endif %}
  <main>
{{ answer_html | safe }}
  </main>
</div>

<div id="card" role="tooltip"></div>

<dialog class="detail" id="modal">
  <button class="close" aria-label="Close">&times;</button>
  <div class="d-band" id="dBand"></div>
  <div class="d-body" id="dBody"></div>
</dialog>

<script>
  // Cite metadata keyed by cite_id. Built server-side from cite_records.
  window.GROUNDLING_CITES = {{ cites_json | safe }};
  window.IMG_REGISTRY = {{ image_slots_json | safe }};
</script>
<script>
(function () {
  const CITES = window.GROUNDLING_CITES || {};
  const REG = window.IMG_REGISTRY || [];

  const STATE_LABELS = {
    supported: 'Supported', partial: 'Partial', unsupported: 'Unsupported',
    'needs-citation': 'Needs citation', none: 'Cite',
  };
  const STATE_GLYPHS = {
    supported: '✓', partial: '~', unsupported: '✕',
    'needs-citation': '+', none: '·',
  };

  // Defense in depth: only allow http(s) URLs to surface as links.
  function safeUrl(u) {
    if (typeof u !== 'string') return '';
    try {
      const parsed = new URL(u);
      if (parsed.protocol === 'http:' || parsed.protocol === 'https:') return u;
    } catch (e) {}
    return '';
  }

  function el(tag, props, ...children) {
    const e = document.createElement(tag);
    if (props) {
      for (const k of Object.keys(props)) {
        const v = props[k];
        if (k === 'class') e.className = v;
        else if (k === 'style' && typeof v === 'object') Object.assign(e.style, v);
        else if (k === 'text') e.textContent = v;
        else if (k === 'html') e.innerHTML = v;  // caller asserts trust
        else e.setAttribute(k, v);
      }
    }
    for (const c of children) {
      if (c == null) continue;
      e.appendChild(typeof c === 'string' ? document.createTextNode(c) : c);
    }
    return e;
  }

  // Spotlight toggle.
  const weakBtn = document.getElementById('weakBtn');
  if (weakBtn) {
    weakBtn.addEventListener('click', () => {
      const on = weakBtn.getAttribute('aria-pressed') === 'true';
      weakBtn.setAttribute('aria-pressed', String(!on));
      document.body.classList.toggle('weak', !on);
    });
  }

  // ---- Hover card ----
  const card = document.getElementById('card');
  let hideT;

  function makeCrop(cite) {
    const w = 392, h = 132, scale = 0.46;
    const root = el('div', { class: 'crop' });
    const cx = cite.bx + cite.bw / 2;
    const cy = cite.by + cite.bh / 2;
    const img = el('img', {
      src: REG[cite.slot],
      style: {
        width: cite.imgW * scale + 'px',
        height: cite.imgH * scale + 'px',
        left: (w / 2 - cx * scale) + 'px',
        top: (h / 2 - cy * scale) + 'px',
      },
    });
    root.appendChild(img);
    root.appendChild(el('div', {
      class: 'crop-hl',
      style: {
        left: (w / 2 - cite.bw * scale / 2) + 'px',
        top: (h / 2 - cite.bh * scale / 2) + 'px',
        width: (cite.bw * scale) + 'px',
        height: (cite.bh * scale) + 'px',
      },
    }));
    return root;
  }

  function buildCard(cite) {
    const state = cite.state || 'none';
    card.replaceChildren(
      el('div', { class: 'card-band band-' + state },
        el('span', { class: 'vg', text: STATE_GLYPHS[state] }),
        STATE_LABELS[state],
      ),
      el('div', { class: 'card-body' },
        el('div', { class: 'card-src' },
          el('span', { class: 'kind', text: cite.kind.toUpperCase() }),
          cite.sourceLabel || '',
        ),
        cite.kind === 'pdf'
          ? makeCrop(cite)
          : el('div', { class: 'excerpt', html: cite.excerptHTML || '' }),
        el('div', { class: 'card-foot' },
          el('span', { text: cite.kind === 'web'
            ? (cite.host || '')
            : 'Highlighted on page ' + (cite.page || '?') }),
          el('span', { class: 'cta', text: 'Click to inspect →' }),
        ),
      ),
    );
  }

  function position(a) {
    const r = a.getBoundingClientRect();
    const cw = 420, ch = card.offsetHeight;
    let left = r.left + r.width / 2 - cw / 2;
    left = Math.max(12, Math.min(left, window.innerWidth - cw - 12));
    let top = r.top - ch - 10;
    if (top < 64) top = r.bottom + 10;
    card.style.left = left + 'px';
    card.style.top = top + 'px';
  }

  document.querySelectorAll('a.cite').forEach((a) => {
    const cite = CITES[a.dataset.citeId];
    if (!cite) return;
    a.addEventListener('mouseenter', () => {
      clearTimeout(hideT);
      buildCard(cite);
      card.classList.add('show');
      requestAnimationFrame(() => position(a));
    });
    a.addEventListener('mouseleave', () => {
      hideT = setTimeout(() => card.classList.remove('show'), 80);
    });
    const open = (e) => { e.preventDefault(); openModal(cite); };
    a.addEventListener('click', open);
    a.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') open(e);
    });
  });

  // ---- Modal ----
  const modal = document.getElementById('modal');

  function openModal(cite) {
    const state = cite.state || 'none';
    const dBand = document.getElementById('dBand');
    dBand.className = 'd-band band-' + state;
    dBand.replaceChildren(
      el('span', {
        class: 'vg',
        style: {
          width: '22px', height: '22px', borderRadius: '50%',
          background: 'rgba(255,255,255,.25)', display: 'grid',
          placeItems: 'center',
        },
        text: STATE_GLYPHS[state],
      }),
      el('h4', { text: STATE_LABELS[state] }),
    );

    const body = document.getElementById('dBody');
    body.replaceChildren();

    body.appendChild(el('div', {
      class: 'd-claim',
      text: '“' + (cite.claim || cite.quote || '') + '”',
    }));

    if (cite.judgeNote) {  // Set by PR 2 (judge integration); always falsy in PR 1.
      const note = el('div', { class: 'd-note' });
      note.appendChild(el('b', { text: 'Why the judge says ' + STATE_LABELS[state] }));
      note.appendChild(document.createTextNode(cite.judgeNote));
      body.appendChild(note);
    }

    if (cite.kind === 'pdf') {
      const page = el('div', { class: 'd-page' });
      page.appendChild(el('img', {
        src: REG[cite.slot],
        alt: 'page ' + (cite.page || '?'),
      }));
      page.appendChild(el('div', {
        class: 'd-page-hl',
        style: {
          left: cite.bxPct + '%', top: cite.byPct + '%',
          width: cite.bwPct + '%', height: cite.bhPct + '%',
        },
      }));
      body.appendChild(page);
      body.appendChild(el('div', {
        class: 'd-src',
        text: (cite.filename || '') + ' — page ' + (cite.page || '?'),
      }));
    } else {
      const excerptStyle = {
        maxHeight: 'none', webkitMaskImage: 'none', maskImage: 'none',
        background: '#f7f7f4', borderRadius: '10px', padding: '13px 15px',
        fontSize: '14px',
      };
      body.appendChild(el('div', {
        class: 'excerpt', style: excerptStyle, html: cite.excerptHTML || '',
      }));
      const src = el('div', { class: 'd-src' });
      // Visible link text is the raw URL (readable). The href uses the
      // urlHighlight form (#:~:text=…) so clicking still scrolls to and
      // highlights the cited passage on the live page.
      const safeHref = safeUrl(cite.urlHighlight || cite.url);
      const safeDisplay = safeUrl(cite.url) || cite.url || '';
      if (safeHref) {
        const link = el('a', { href: safeHref, target: '_blank', rel: 'noopener', text: safeDisplay });
        src.appendChild(link);
      } else {
        src.appendChild(document.createTextNode(safeDisplay));
      }
      if (cite.fetchedAt) {
        src.appendChild(document.createTextNode(' · fetched ' + cite.fetchedAt));
      }
      body.appendChild(src);
    }

    card.classList.remove('show');
    modal.showModal();
  }

  modal.querySelector('.close').addEventListener('click', () => modal.close());
  modal.addEventListener('click', (e) => { if (e.target === modal) modal.close(); });

  // Deep link: #cite-N opens that cite's modal on load.
  const hm = location.hash.match(/^#cite-(\d+)$/);
  if (hm) { const c = CITES[hm[1]]; if (c) openModal(c); }
})();
</script>
</body>
</html>
